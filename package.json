{
  "name": "@zalo-platforms/openclaw-zaloclawbot",
  "version": "0.1.4",
  "description": "Zalo channel for OpenClaw — QR-onboarded personal bot",
  "license": "MIT",
  "author": "Zalo Platforms",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "index.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "openclaw": "2026.9.5",
    "typescript": "^5.8.0",
    "@types/node": "^26.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "vitest": "^5.0.1"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "openclaw-zaloclawbot",
      "label": "Zalo ClawBot",
      "selectionLabel": "Zalo ClawBot (QR)",
      "docsPath": "/channels/zaloclawbot",
      "docsLabel": "zaloclawbot",
      "blurb": "Personal Zalo bot — QR-onboarded, owner-bound.",
      "order": 81
    },
    "install": {
      "npmSpec": "@zalo-platforms/openclaw-zaloclawbot",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    }
  }
}
